{
  "name": "lltools",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron.cjs",
  "imports": {
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.lltools.app",
    "productName": "LLTools",
    "artifactName": "LLTools-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon.png"
    },
    "files": [
      "**/*",
      "dist/**/*",
      ".env"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Lray143",
        "repo": "LLTools"
      }
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.19.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jimp": "^0.16.1",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "vite": "^8.0.0",
    "wait-on": "^9.0.0"
  }
}
